---
interface Props {
  copyright?: string;
}

const { copyright = 'All rights reserved.' } = Astro.props;
---

<footer class="wf-footer">
  <div class="wf-footer__inner">
    <p>{copyright}</p>
  </div>
</footer>

<style>
  .wf-footer { border-top: 1px solid color-mix(in srgb, var(--wf-color-text) 12%, transparent); color: var(--wf-color-muted); }
  .wf-footer__inner { margin-inline: auto; max-width: var(--wf-content-width); padding: 1.5rem clamp(1rem, 4vw, 2.5rem); }
  p { font: 400 0.875rem/1.5 var(--wf-font-body); margin: 0; }
</style>
