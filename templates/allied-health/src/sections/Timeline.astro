---
import type { SectionProps } from "../schema";
interface Props extends SectionProps<"clinic/Timeline"> {}
const { eyebrow, title, intro, items } = Astro.props;
---

<section class="section" data-section="clinic/Timeline">
  <div class="wrap two-col">
    <div>
      <div class="eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
      <p class="lead">{intro}</p>
    </div>
    <div class="timeline">
      {items.map((item) => (
        <div class="timeline-item">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
