---
import "virtual:webfactory-styles";
import DocumentLayout from "@webfactory/layouts/DocumentLayout.astro";

import { I18N } from "astrowind:config";

import CommonMeta from "@webfactory/template-astrowind/components/common/CommonMeta.astro";
import CustomStyles from "@webfactory/template-astrowind/components/CustomStyles.astro";
import ApplyColorMode from "@webfactory/template-astrowind/components/common/ApplyColorMode.astro";
import Metadata from "@webfactory/template-astrowind/components/common/Metadata.astro";
import SiteVerification from "@webfactory/template-astrowind/components/common/SiteVerification.astro";
import Analytics from "@webfactory/template-astrowind/components/common/Analytics.astro";
import Intersect from "@webfactory/template-astrowind/components/common/Intersect.astro";

// Comment the line below to disable View Transitions
import { ClientRouter } from "astro:transitions";

import type { MetaData as MetaDataType } from "@webfactory/template-astrowind/types";

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<DocumentLayout
  lang={language}
  dir={textDirection}
  htmlClass="2xl:text-[20px]"
  bodyClass="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col"
  skipTargetId="main-content"
>
  <Fragment slot="head">
    <CommonMeta />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </Fragment>
  <slot />
  <Intersect />
</DocumentLayout>
