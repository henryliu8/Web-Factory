---
import Layout from "@webfactory/template-astrowind/layouts/Layout.astro";
import Header from "@webfactory/template-astrowind/sections/Header.astro";
import Footer from "@webfactory/template-astrowind/sections/Footer.astro";
import Announcement from "@webfactory/template-astrowind/sections/Announcement.astro";

import type { MetaData } from "@webfactory/template-astrowind/types";

export interface Props {
  metadata?: MetaData;
  header?: Record<string, unknown>;
  footer?: Record<string, unknown>;
  showAnnouncement?: boolean;
}

const {
  metadata,
  header = {},
  footer = {},
  showAnnouncement = false,
} = Astro.props;
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {/*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */}
  {Astro.slots.has("announcement") ? (
    <slot name="announcement" />
  ) : (
    showAnnouncement && <Announcement />
  )}
  {Astro.slots.has("header") ? (
    <slot name="header" />
  ) : (
    <Header {...header} isSticky showToggleTheme />
  )}
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has("footer") ? <slot name="footer" /> : <Footer {...footer} />}
</Layout>
