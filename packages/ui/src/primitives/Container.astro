---
import type { ContainerProps } from '../component-types';

const { as: Element = 'div', width = 'default', class: className = '' } = Astro.props satisfies ContainerProps;
---

<Element class:list={['wf-container', `wf-container--${width}`, className]}>
  <slot />
</Element>

<style>
  .wf-container {
    margin-inline: auto;
    max-width: var(--wf-container-max);
    padding-inline: var(--wf-container-padding);
    width: 100%;
  }

  .wf-container--wide { max-width: 90rem; }
  .wf-container--narrow { max-width: 50rem; }
  .wf-container--full { max-width: none; }
</style>
