---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['wf-container', className]}>
  <slot />
</div>

<style>
  .wf-container {
    margin-inline: auto;
    max-width: var(--wf-content-width);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    width: 100%;
  }
</style>
