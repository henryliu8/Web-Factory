---
import type { ButtonProps } from '../component-types';

const { href, variant = 'primary', size = 'md', disabled = false, type = 'button', class: className = '' } = Astro.props satisfies ButtonProps;
const classes = ['wf-button', `wf-button--${variant}`, `wf-button--${size}`, className];
---

{href && !disabled ? (
  <a class:list={classes} href={href}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .wf-button {
    align-items: center;
    border: 1px solid transparent;
    border-radius: var(--wf-radius-md);
    cursor: pointer;
    display: inline-flex;
    font: 600 0.9375rem/1 var(--wf-font-body);
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    transition: background-color var(--wf-motion-normal), border-color var(--wf-motion-normal), color var(--wf-motion-normal), transform var(--wf-motion-normal);
  }

  .wf-button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .wf-button:focus-visible {
    outline: 3px solid var(--wf-color-focus);
    outline-offset: 3px;
  }

  .wf-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .wf-button--sm { font-size: var(--wf-font-size-sm); min-height: 2.25rem; padding: 0.5rem 0.875rem; }
  .wf-button--lg { font-size: var(--wf-font-size-lg); min-height: 3.25rem; padding: 0.875rem 1.5rem; }

  .wf-button--primary {
    background: var(--wf-color-primary);
    color: var(--wf-color-on-primary);
  }

  .wf-button--secondary {
    background: transparent;
    border-color: var(--wf-color-primary);
    color: var(--wf-color-primary);
  }

  .wf-button--outline {
    background: transparent;
    border-color: var(--wf-color-border);
    color: var(--wf-color-text);
  }

  .wf-button--ghost {
    background: transparent;
    color: var(--wf-color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .wf-button { transition: none; }
    .wf-button:hover:not(:disabled) { transform: none; }
  }
</style>
