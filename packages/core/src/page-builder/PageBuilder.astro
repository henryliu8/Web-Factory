---
import { resolveSections } from "./resolveSection";
import type { PageBuilderProps } from "./types";

const { sections, sectionRegistry, sectionParser } =
  Astro.props as PageBuilderProps;
const resolvedSections = resolveSections(
  sectionRegistry,
  sections,
  sectionParser,
);
---

<div class="wf-page-builder">
  {resolvedSections.map(({ component, definition }) => {
    const Component = component as any;
    const { type: _type, ...props } = definition;
    return <Component {...props} />;
  })}
</div>
