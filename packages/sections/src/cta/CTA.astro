---
import Button from '@webfactory/ui/primitives/Button';
import Container from '@webfactory/ui/primitives/Container';
import type { ContainerProps } from '@webfactory/ui';

const TypedContainer = Container as unknown as (props: ContainerProps) => unknown;

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  button?: { label: string; href: string };
  secondaryButton?: { label: string; href: string };
  class?: string;
}

const {
  title,
  description,
  eyebrow,
  button,
  secondaryButton,
  class: className = "",
} = Astro.props;
---

<section class:list={["wf-cta", className]}>
  <TypedContainer class="wf-cta__inner">
    <div>
      {eyebrow && <p class="wf-cta__eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      {description && <p>{description}</p>}
    </div>
    {
      (button || secondaryButton) && (
        <div class="wf-cta__actions">
          {button && <Button href={button.href}>{button.label}</Button>}
          {secondaryButton && (
            <Button href={secondaryButton.href} variant="outline">
              {secondaryButton.label}
            </Button>
          )}
        </div>
      )
    }
  </TypedContainer>
</section>

<style>
  .wf-cta {
    background: var(--wf-color-primary);
    color: var(--wf-color-on-primary);
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  :global(.wf-cta__inner) {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
  }
  .wf-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--wf-space-3);
  }
  .wf-cta__eyebrow {
    font-size: var(--wf-font-size-sm);
    letter-spacing: 0.1em;
    margin: 0 0 var(--wf-space-3);
    text-transform: uppercase;
  }
  h2 {
    color: inherit;
    font: 700 clamp(2rem, 4vw, 3.5rem)/1.05 var(--wf-font-heading);
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 16ch;
  }
  p {
    font: 400 1rem/1.6 var(--wf-font-body);
    margin: 1rem 0 0;
    max-width: 36rem;
    opacity: 0.8;
  }
  :global(.wf-cta .wf-button--outline) {
    border-color: var(--wf-color-on-primary);
    color: var(--wf-color-on-primary);
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    :global(.wf-cta__inner) {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
