---
import { getEntry } from 'astro:content';
import ProjectShell from '../layouts/ProjectShell.astro';

const entry = await getEntry('pages', 'about');
if (!entry || entry.data.kind !== 'about') throw new Error('About content entry is missing or invalid.');
const { title, description, intro, story, principles, stats } = entry.data;
---

<ProjectShell {title} {description} pageClass="page-about">
  <header class="page-hero section">
    <h1>{title}</h1>
    <p>{intro}</p>
  </header>

  <div class="editorial-image editorial-image--wide">
    <img src="/images/home/smoked-oak.webp" alt="Warm dining interior featuring natural materials" width="1536" height="1024" />
  </div>

  <section class="section story-list" aria-label="Our story">
    {story.map((item, index) => (
      <article>
        <span>0{index + 1}</span>
        <h2>{item.title}</h2>
        <p>{item.text}</p>
      </article>
    ))}
  </section>

  <section class="section principles" aria-labelledby="principles-title">
    <div class="section__heading section__heading--single"><h2 id="principles-title">What guides the work</h2></div>
    <div class="principles__grid">
      {principles.map((principle) => <article><h3>{principle.title}</h3><p>{principle.description}</p></article>)}
    </div>
  </section>

  <section class="stats" aria-label="Studio facts">
    {stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
  </section>
</ProjectShell>
