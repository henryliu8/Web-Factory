---
import { getEntry } from 'astro:content';
import ProjectShell from '../../layouts/ProjectShell.astro';

const entry = await getEntry('pages', 'services');
if (!entry || entry.data.kind !== 'services') throw new Error('Services content entry is missing or invalid.');
const { title, description, intro, services } = entry.data;
---

<ProjectShell {title} {description} pageClass="page-services">
  <header class="page-hero section">
    <h1>{title}</h1>
    <p>{intro}</p>
  </header>

  <section class="service-list section" aria-label="Available flooring services">
    {services.map((service, index) => (
      <article>
        <div class="service-list__image"><img src={service.image.src} alt={service.image.alt} width="1536" height="1024" loading={index === 0 ? 'eager' : 'lazy'} /></div>
        <div class="service-list__content">
          <span>0{index + 1}</span>
          <h2>{service.name}</h2>
          <p class="service-list__summary">{service.summary}</p>
          <p>{service.detail}</p>
          <a class="text-link" href={`/services/${service.slug}`}>View material <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </section>
</ProjectShell>
