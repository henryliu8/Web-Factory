---
import { getCollection, type CollectionEntry } from 'astro:content';
import ProjectShell from '../../layouts/ProjectShell.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('pages')).filter((entry) => entry.data.kind === 'service');
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').at(-1) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
if (entry.data.kind !== 'service') throw new Error(`Invalid service content entry: ${entry.id}`);
const { title, description, intro, material, image, benefits, steps } = entry.data;
---

<ProjectShell {title} {description} pageClass="page-service-detail">
  <div class="service-hero">
    <div class="service-hero__content">
      <a class="back-link" href="/services">← All services</a>
      <span>{material}</span>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
    <img src={image.src} alt={image.alt} width="1536" height="1024" />
  </div>

  <section class="section detail-grid" aria-labelledby="benefits-title">
    <h2 id="benefits-title">Why we specify it</h2>
    <ul>{benefits.map((benefit) => <li>{benefit}</li>)}</ul>
  </section>

  <section class="section process process--detail" aria-labelledby="detail-process-title">
    <h2 id="detail-process-title">From selection to installation</h2>
    <ol>
      {steps.map((step, index) => <li><span>0{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}
    </ol>
  </section>
</ProjectShell>
