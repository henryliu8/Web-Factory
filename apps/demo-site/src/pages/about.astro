---
import { getEntry } from 'astro:content';
import StandardPageTemplate from '@webfactory/template-stardrive/page-templates/StandardPageTemplate';
import { site } from '../config/site';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content entry: about');
---

<StandardPageTemplate
  metadata={{ title: entry.data.title, description: entry.data.description, lang: site.language }}
  header={{ brand: site.name, items: site.navigation }}
  heading={entry.data.title}
  intro="A compact reference application proving the Web Factory layers work together in a real Astro project."
>
  <div class="demo-prose">
    <h2>Built as an integration reference</h2>
    <p>This site began with the Stardrive CLI scaffold, then added project content and one focused component override.</p>
    <p>Shared packages remain reusable, the template owns page structure, the selected theme owns appearance, and this application owns its final content and adjustments.</p>
  </div>
</StandardPageTemplate>
