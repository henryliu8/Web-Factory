---
import { getEntry } from 'astro:content';
import StandardPageTemplate from '@webfactory/template-stardrive/page-templates/StandardPageTemplate';
import { site } from '../config/site';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing content entry: contact');
---

<StandardPageTemplate
  metadata={{ title: entry.data.title, description: entry.data.description, lang: site.language }}
  header={{ brand: site.name, items: site.navigation }}
  heading={entry.data.title}
  intro="This page demonstrates straightforward semantic project content without expanding the forms package."
>
  <div class="demo-prose">
    <h2>Demo contact details</h2>
    <address>
      Web Factory Demo<br />
      Reference application<br />
      <a href="mailto:demo@example.com">demo@example.com</a>
    </address>
    <p>These details are intentionally generic and exist only to exercise the page structure.</p>
  </div>
</StandardPageTemplate>
