# Build-time public key: Google reCAPTCHA v2 "I'm not a robot" checkbox.
# Register localhost for development, and your real hostname for production.
PUBLIC_RECAPTCHA_SITE_KEY=

# Server-only secrets, read at runtime. Never use PUBLIC_ for these.
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=

# Use a sender address on your verified Resend domain (no display name here).
CONTACT_FROM_EMAIL=website@your-domain.example
CONTACT_TO_EMAIL=risingtreealliedhealth@gmail.com

# Exact browser origin. Change this for your real HTTPS domain before deployment.
# localhost and 127.0.0.1 are different origins; use the one you browse.
CONTACT_ORIGIN=http://localhost:4321

# Optional local Astro dev only. Production builds always require reCAPTCHA.
# Bind the dev server to loopback; do not expose it through a public tunnel.
CONTACT_DISABLE_RECAPTCHA=false
